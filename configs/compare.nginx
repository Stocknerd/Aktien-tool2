# HTTP -> HTTPS redirect
server {
    listen 80;
    server_name compare.schatzsuche40.de;
    return 301 https://$host$request_uri;
}

# HTTPS vhost
server {
    listen 443 ssl http2;
    server_name compare.schatzsuche40.de;

    ssl_certificate /etc/letsencrypt/live/compare.schatzsuche40.de/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/compare.schatzsuche40.de/privkey.pem;

    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: https:; script-src 'self' 'unsafe-inline' https://securepubads.g.doubleclick.net https://pagead2.googlesyndication.com https://console.googletagservices.com https://www.googletagmanager.com https://s3.tradingview.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; frame-src https://securepubads.g.doubleclick.net https://tpc.googlesyndication.com https://s.tradingview.com https://www.tradingview.com; connect-src 'self' https://securepubads.g.doubleclick.net https://googleads.g.doubleclick.net https://pagead2.googlesyndication.com https://www.google-analytics.com https://*.google-analytics.com; frame-ancestors 'self' https://schatzsuche40.de https://*.schatzsuche40.de" always;

    location = /ads.txt {
        types { }
        default_type text/plain;
        alias /var/www/compare/ads.txt;
        add_header Cache-Control "public, max-age=600";
    }

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_hide_header X-Frame-Options;
    }
}
